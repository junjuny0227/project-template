DATABASE_URL=postgresql://template:template@localhost:5432/template
PORT=4000
JWT_SECRET=replace-this-placeholder-with-a-random-secret
CORS_ORIGINS=http://localhost:3000
# NODE_ENV는 비워 두면 development다. 운영 배포 환경에서만 production으로 설정한다.
# 여기에 값을 적지 않는 이유: CI·검증 스크립트가 이 파일을 셸 환경으로 읽어 웹 빌드(next build)에도 NODE_ENV가 들어가기 때문이다.
