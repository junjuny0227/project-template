{
  "name": "project-template-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fsd": "turbo run lint:fsd",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e test:fullstack",
    "test:fullstack": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "turbo": "2.11.10",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "6.0.3"
  }
}
