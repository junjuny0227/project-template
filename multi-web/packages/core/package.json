{
  "name": "@repo/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./shared/*": "./src/shared/*/index.ts",
    "./shared/*/server": "./src/shared/*/index.server.ts",
    "./entities/*": "./src/entities/*/index.ts",
    "./entities/*/server": "./src/entities/*/index.server.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fsd": "steiger ./src --fail-on-warnings",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "axios": "catalog:",
    "server-only": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@feature-sliced/steiger-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "steiger": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
